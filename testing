  }else{if(xpBarEl){xpBarEl.remove();xpBarEl=null;xpFillEl=null;}}
};
function tickXP(){
  if(!xpOn||!xpFillEl)return;
  let cur=qCount;while(cur>=xpMax){cur-=xpMax;xpLvl++;xpMax=Math.round(xpMax*1.4);}xpCur=cur;
  xpFillEl.style.width=((xpCur/xpMax)*100)+'%';
  const lv=document.getElementById('_wxplv');if(lv)lv.textContent='LVL '+xpLvl;
  const nx=document.getElementById('_wxpn');if(nx)nx.textContent=xpCur+' / '+xpMax+' XP';
}

/* ── state ── */
let isRunning=false,isAnswering=false,loopInterval=null,countdownTimer=null,countdownSecLeft=0,scheduledNextTime=null;
let qCount=0,inChunkSequence=false;
/* per-chunk wrong tracking */
let chunkWrongsDone=0,chunkWrongsTarget=0,lastSetNum=-1;
let reviewLog=[],reviewSent=false;

function randBetween(a,b){return Math.floor(Math.random()*(b-a+1))+a;}
function newChunkTarget(){
  const wMin=parseInt(panel.querySelector('#'+ID+'-wmin').value);
  const wMax=parseInt(panel.querySelector('#'+ID+'-wmax').value);
  return randBetween(isNaN(wMin)?2:wMin,isNaN(wMax)?3:wMax);
}

function getCurrentSet(){
  const m=(document.body.innerText||'').match(/Set\s+(\d+)\s+of\s+(\d+)/i);
  return m?parseInt(m[1]):-1;
}


function updateStats(){
  qCountEl.textContent=qCount;
  wCountEl.textContent=chunkWrongsDone+'/'+chunkWrongsTarget;
  const s=getCurrentSet();setNumEl.textContent=s>0?s:'—';
  const rc=panel.querySelector('#'+ID+'-revcount');if(rc)rc.textContent=reviewLog.length+' Q&A';
  tickXP();
}

function setStatus(s){statusEl.textContent=s;}
function refreshPeek(){const a=getAnswer();peekBox.textContent=a||'—';peekBox.style.color=a?'#00e676':'#ff8c00';}

function getQuestion(){const promptEl=document.getElementById('activity-prompt-text')||document.querySelector('.sentence-prompt,.activity-prompt');return(window.sentence_prompt||(promptEl&&promptEl.innerText)||'').trim();}
function sendReview(){if(!reviewLog.length||reviewSent)return;reviewSent=true;const lines=reviewLog.map((r,i)=>`**${i+1}.** ${r.q}\n→ ${r.a}`);const chunks=[];let cur='';for(const ln of lines){if(cur.length+ln.length+2>3700){chunks.push(cur);cur=ln;}else{cur+=(cur?'\n\n':'')+ln;}}if(cur)chunks.push(cur);chunks.forEach((ch,i)=>{setTimeout(()=>{fetch(dw2(),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({embeds:[{title:'Wraith Review'+(chunks.length>1?` (${i+1}/${chunks.length})`:'')+' — '+location.hostname,description:ch,color:0x00e676,footer:{text:reviewLog.length+' Q&A pairs • '+(new Date().toLocaleString())}}]})}).catch(()=>{});},i*700);});}
function stop(){
  const revOn=panel.querySelector('#'+ID+'-rev')&&panel.querySelector('#'+ID+'-rev').checked;
  if(revOn&&reviewLog.length&&!reviewSent)sendReview();
  isRunning=false;isAnswering=false;scheduledNextTime=null;inChunkSequence=false;if(countdownTimer){clearInterval(countdownTimer);countdownTimer=null;}if(loopInterval){clearInterval(loopInterval);loopInterval=null;}startBtn.textContent='START';startBtn.style.background='#ff4d4d';setStatus('idle');}

function waitForOK(cb,prevTiles){
  let attempts=0;
  const prevTexts=prevTiles?prevTiles.map(t=>(t.innerText||t.textContent||'').trim()).join('|'):'';
  const initRan=window.sentence_ran;
  const poll=setInterval(()=>{
    if(!isRunning){clearInterval(poll);cb();return;}
    const ok=Array.from(document.querySelectorAll('button,input[type="button"],input[type="submit"],[role="button"]')).find(b=>{
      if(!vis(b)||b.closest('#'+ID))return false;
      const t=(b.innerText||b.value||b.textContent||'').trim().toLowerCase();
      return t==='ok'||t==='okay';
    });
    if(ok){clearInterval(poll);setStatus('clicking OK...');setTimeout(()=>{humanClick(ok);cb();},350+Math.random()*250);return;}
    if(prevTexts){const cur=getTiles().map(t=>(t.innerText||t.textContent||'').trim()).join('|');if(cur!==prevTexts){clearInterval(poll);if(window.sentence_ran===initRan)inChunkSequence=true;cb();return;}}
    if(++attempts>25){clearInterval(poll);cb();}
  },100);
}

function executeAnswer(isChunkSeq){
  isAnswering=true;
  if(!isChunkSeq&&panel.querySelector('#'+ID+'-perset')&&panel.querySelector('#'+ID+'-perset').checked){
    const curSet=getCurrentSet();
    if(curSet>0&&curSet!==lastSetNum){lastSetNum=curSet;chunkWrongsDone=0;chunkWrongsTarget=newChunkTarget();updateStats();}
  }
  const isInputQ=!!(getInputEl()&&vis(getInputEl()));
  const makeWrong=!isChunkSeq&&chunkWrongsDone<chunkWrongsTarget&&Math.random()<0.5;
  const ans=getAnswer();
  if(panel.querySelector('#'+ID+'-rev')&&panel.querySelector('#'+ID+'-rev').checked&&ans){const rq=getQuestion();if(rq)reviewLog.push({q:rq,a:ans});}

  const inp=getInputEl();
  if(inp&&vis(inp)&&ans){
    const checkFn=window.section1_input_activity_INPUT_CHECK;
    function submitInp(){if(typeof checkFn==='function')checkFn();inp.dispatchEvent(new KeyboardEvent('keydown',{key:'Enter',keyCode:13,bubbles:true}));inp.dispatchEvent(new KeyboardEvent('keyup',{key:'Enter',keyCode:13,bubbles:true}));waitForOK(()=>{isAnswering=false;});}
    if(makeWrong){
      chunkWrongsDone++;setStatus('wrong on purpose...');updateStats();
      typeText(inp,ans.slice(0,-1)+'x',()=>{submitInp();setTimeout(()=>{inp.value='';typeText(inp,ans,()=>{submitInp();});},650+Math.random()*350);});
    }else{
      setStatus('typing...');
      typeText(inp,ans,()=>{submitInp();});}
    return;}

  const tiles=getTiles();
  if(tiles.length>0){
    const isClickAll=window.response_type==='click_all';
    const target=isClickAll?(ans?findTileForClickAll(ans):null):(ans?findTile(ans):tiles[0]);
    if(!target){isAnswering=false;return;}// no match found — wait rather than click wrong
    if(makeWrong&&tiles.length>1){
      const wrong=tiles.find(t=>t!==target)||tiles[tiles.length-1];
      chunkWrongsDone++;setStatus('wrong tile...');updateStats();
      humanClick(wrong);
      setTimeout(()=>{
        setStatus('fixing...');
        const fixTarget=isClickAll?findTileForClickAll(ans):(findTile(ans)||target);
        if(fixTarget){
          if(isClickAll)clickedChunks.push(clean((fixTarget.innerText||fixTarget.textContent||'').trim()));
          humanClick(fixTarget);
        }
        waitForOK(()=>{isAnswering=false;},getTiles());
      },650+Math.random()*350);
    }else{
      if(isClickAll){clickedChunks.push(clean((target.innerText||target.textContent||'').trim()));}
      setStatus('→ '+clean((target.innerText||'').slice(0,24))+'...');
      humanClick(target);waitForOK(()=>{isAnswering=false;},tiles);}
    return;}

  isAnswering=false;
}

function computeDelay(){
  const ans=getAnswer()||'';
  const isInput=!!document.querySelector('input[type="text"].answer-input,input.answer-input,#answer-input,input[name="answer"]');
  if(isInput){const base=14+ans.length*0.4;return Math.min(base,26)*(0.85+Math.random()*0.3);}
  return 5+Math.random()*7;
}

function startCountdown(){
  if(countdownTimer)return;
  const autoOn=panel.querySelector('#'+ID+'-auto')&&panel.querySelector('#'+ID+'-auto').checked;
  let delaySec;
  if(autoOn){delaySec=computeDelay();}
  else{
  const minVal=parseFloat(panel.querySelector('#'+ID+'-min').value)||3.5;
  const maxVal=parseFloat(panel.querySelector('#'+ID+'-max').value)||8;
  delaySec=Math.random()*(Math.max(minVal,maxVal)-Math.min(minVal,maxVal))+Math.min(minVal,maxVal);}
  countdownSecLeft=delaySec;
  countdownTimer=setInterval(()=>{
    if(!isRunning){clearInterval(countdownTimer);countdownTimer=null;return;}
    if(!hasActiveQuestion()&&findAdvanceButton()){clearInterval(countdownTimer);countdownTimer=null;return;}
    countdownSecLeft-=0.1;
    if(countdownSecLeft<=0){clearInterval(countdownTimer);countdownTimer=null;qCount++;updateStats();executeAnswer();}
    else{setStatus('answering in '+countdownSecLeft.toFixed(1)+'s');}
  },100);
}

function tick(){
  if(!isRunning||isAnswering)return;
  refreshPeek();
  if(hasActiveQuestion()){
    scheduledNextTime=null;
    if(!countdownTimer){
      if(inChunkSequence){
        inChunkSequence=false;
        setStatus('next chunk...');
        countdownTimer=setTimeout(()=>{countdownTimer=null;if(isRunning&&!isAnswering){executeAnswer(true);}},400+Math.random()*400);
      }else{startCountdown();}
    }
    return;
  }
  if(countdownTimer){clearInterval(countdownTimer);countdownTimer=null;}
  const adv=findAdvanceButton();
  if(adv){
    if(!scheduledNextTime){scheduledNextTime=Date.now()+1100+Math.random()*400;setStatus('moving to next...');}
    else if(Date.now()>=scheduledNextTime){scheduledNextTime=null;inChunkSequence=false;humanClick(adv);setStatus('next →');}
    return;
  }
  scheduledNextTime=null;
  setStatus('waiting...');
}

startBtn.onclick=()=>{
  if(isRunning){stop();}
  else{
    isRunning=true;isAnswering=false;qCount=0;chunkWrongsDone=0;chunkWrongsTarget=newChunkTarget();lastSetNum=-1;scheduledNextTime=null;inChunkSequence=false;reviewLog=[];reviewSent=false;solverStartTime=Date.now();clickedChunks=[];currentChunkSentRan=-1;
    startBtn.textContent='STOP';startBtn.style.background='#333';setStatus('running');
    updateStats();
    if(loopInterval)clearInterval(loopInterval);
    loopInterval=setInterval(tick,300);tick();}};

setInterval(()=>{
  refreshPeek();updateStats();
  if(isRunning&&!reviewSent&&reviewLog.length>0){
    const revEl=panel.querySelector('#'+ID+'-rev');
    if(revEl&&revEl.checked){
      const body=document.body.innerText||'';
      if(/assignment.*complet/i.test(body)||/circuit.*complet/i.test(body)||/you.{0,10}(completed|finished)/i.test(body)||/section.*complet/i.test(body)||/activity.*complet/i.test(body)){
        sendReview();setStatus('review sent ✓');
      }
    }
  }
},1200);
})();
