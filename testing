(function(){const ID='wraith-solver-v2';const prev=document.getElementById(ID);if(prev){prev.remove();return;}

function vis(el){if(!el)return false;try{const s=window.getComputedStyle(el);if(s.display==='none'||s.visibility==='hidden'||parseFloat(s.opacity)===0)return false;const r=el.getBoundingClientRect();return(r.width>0&&r.height>0);}catch(e){return el.offsetWidth>0;}}
function clean(s){return(s||'').replace(/<[^>]*>/g,'').replace(/\s+/g,' ').trim().toLowerCase();}
function humanClick(el){if(!el)return;const r=el.getBoundingClientRect();const x=r.left+r.width*0.3+Math.random()*r.width*0.4;const y=r.top+r.height*0.3+Math.random()*r.height*0.4;['mouseover','mouseenter','mousemove','mousedown','mouseup','click'].forEach(t=>{el.dispatchEvent(new MouseEvent(t,{bubbles:true,cancelable:true,view:window,clientX:x,clientY:y}));});try{el.click();}catch(e){}}
function typeText(el,text,cb){el.focus();el.value='';let i=0;function next(){if(i<text.length){el.value+=text[i];['input','change','keyup'].forEach(t=>el.dispatchEvent(new Event(t,{bubbles:true})));i++;setTimeout(next,22+Math.random()*42);}else if(cb)cb();}next();}

function getAnswer(){try{
  if(typeof window.activity_type!=='undefined'&&window.activity_type==='paragraph_parallel'){
    if(window.response_type==='find_it')return(window.response_language==='l2')?window.finditchunks[window.findit_q][1]:window.finditchunks[window.findit_q][0];
    if(typeof window.get_para_sentences==='function')return window.get_para_sentences(window.para_sentence,window.response_language,false);
  }
  if(typeof window.one_word_answer!=='undefined'&&window.one_word_answer)return window.one_word_answer;
  const ran=typeof window.sentence_ran!=='undefined'?window.sentence_ran:-1;
  const lang=window.response_language||(document.querySelector('.match-sentence')?'l1':'l2');
  const isChunk=typeof window.response_type!=='undefined'&&(window.response_type==='chunk_match'||window.response_type==='chunk_flashcards');
  if(ran!==-1){
    if(lang==='l1'){
      if(isChunk&&window.uniquel1vocabchunks&&window.uniquel1vocabchunks[ran])return window.uniquel1vocabchunks[ran];
      if(isChunk&&window.uniquel1chunks&&window.uniquel1chunks[ran])return window.uniquel1chunks[ran];
      if(window.l1sentences&&window.l1sentences[ran])return window.l1sentences[ran];
      if(window.uniquel1chunks&&window.uniquel1chunks[ran])return window.uniquel1chunks[ran];
    }else{
      if(isChunk&&window.uniquel2vocabchunks&&window.uniquel2vocabchunks[ran])return window.uniquel2vocabchunks[ran];
      if(isChunk&&window.uniquel2chunks&&window.uniquel2chunks[ran])return window.uniquel2chunks[ran];
      if(window.l2sentences&&window.l2sentences[ran])return window.l2sentences[ran];
      if(window.uniquel2chunks&&window.uniquel2chunks[ran])return window.uniquel2chunks[ran];
    }
  }
  const promptEl=document.getElementById('activity-prompt-text')||document.querySelector('.sentence-prompt,.activity-prompt');
  const pText=clean(window.sentence_prompt||(promptEl&&promptEl.innerText)||'');
  if(pText){
    const pairs=[[window.l2sentences,window.l1sentences],[window.l1sentences,window.l2sentences],[window.uniquel2chunks,window.uniquel1chunks],[window.uniquel1chunks,window.uniquel2chunks],[window.uniquel2vocabchunks,window.uniquel1vocabchunks],[window.uniquel1vocabchunks,window.uniquel2vocabchunks]];
    for(const[src,dst]of pairs){if(!src||!dst)continue;const i=src.findIndex(c=>clean(c)===pText||pText.includes(clean(c))||clean(c).includes(pText));if(i!==-1&&dst[i])return dst[i];}
  }
}catch(e){}return '';}

function getTiles(){
  const specific=Array.from(document.querySelectorAll('#possible-matches button,.match-sentence,.activity-tile,button.sentence-tile,.tile-btn,.sentence-option,.answer-choice,.choice-btn')).filter(b=>vis(b)&&!b.classList.contains('disabled')&&!b.classList.contains('action_disabled')&&!b.closest('#'+ID));
  if(specific.length)return specific;
  return Array.from(document.querySelectorAll('button')).filter(b=>{
    if(!vis(b)||b.disabled||b.closest('#'+ID))return false;
    const t=(b.innerText||b.textContent||'').trim();
    return t.split(' ').length>=3&&t.length>10&&t.length<300;
  });
}
function hasActiveQuestion(){const inp=document.getElementById('answer-input')||document.getElementById('one-word-input');if(inp&&vis(inp))return true;return getTiles().length>0;}
function findTile(answer){
  const tiles=getTiles();if(!tiles.length)return null;
  const ca=clean(answer);if(!ca)return tiles[0];
  for(const t of tiles){if(clean(t.innerText||t.textContent)===ca)return t;}
  const aWords=new Set(ca.split(' ').filter(w=>w.length>2));let best=null,bestScore=0;
  for(const t of tiles){const ct=clean(t.innerText||t.textContent);const tWords=ct.split(' ').filter(w=>w.length>2);const hits=tWords.filter(w=>aWords.has(w)).length;const score=hits/(Math.max(aWords.size,tWords.length)||1);if(score>bestScore){bestScore=score;best=t;}}
  return bestScore>0.35?best:tiles[0];
}
function findAdvanceButton(){
  const explicit=['#next-q-button','#findit-next-button','#modal-confirm-yes-button','#circuit-modal-proceed','.sr-start-notice button','.begin-or-resume','.btn-next','#next-btn','.next-btn','#next-button','.next-button','#next_button','.next_button','button.next','a.next','#continue-button','.continue-button','#circuit-continue','#next-question'];
  for(const s of explicit){try{const el=document.querySelector(s);if(el&&vis(el)&&!el.disabled&&!el.closest('#'+ID))return el;}catch(e){}}
  const blacklist=['back','return','exit','quit','cancel','close','setting','sound','music','logout','cookie','class','fullscreen'];
  const candidates=Array.from(document.querySelectorAll('button,a,input[type="button"],input[type="submit"],[role="button"]')).filter(el=>vis(el)&&!el.disabled&&!el.closest('#'+ID));
  for(const el of candidates){const txt=(el.innerText||el.value||el.textContent||'').trim().toLowerCase();if(!txt||blacklist.some(b=>txt.includes(b)))continue;if(txt==='next'||txt==='next question'||txt==='continue'||txt==='resume'||txt==='proceed'||txt==='yes'||txt==='ok'||txt.startsWith('next ')||txt==='continue circuit'||txt==='next set')return el;}
  return null;
}

