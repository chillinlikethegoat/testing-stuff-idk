javascript:(function(){const ID='wraith-solver-v2';const prev=document.getElementById(ID);if(prev){prev.remove();return;}

function vis(el){if(!el)return false;try{const s=window.getComputedStyle(el);if(s.display==='none'||s.visibility==='hidden'||parseFloat(s.opacity)===0)return false;const r=el.getBoundingClientRect();return(r.width>0&&r.height>0);}catch(e){return el.offsetWidth>0;}}

function clean(s){return(s||'').replace(/<[^>]*>/g,'').replace(/\s+/g,' ').trim().toLowerCase();}

function humanClick(el){if(!el)return;const r=el.getBoundingClientRect();const x=r.left+r.width*0.3+Math.random()*r.width*0.4;const y=r.top+r.height*0.3+Math.random()*r.height*0.4;['mouseover','mouseenter','mousemove','mousedown','mouseup','click'].forEach(t=>{el.dispatchEvent(new MouseEvent(t,{bubbles:true,cancelable:true,view:window,clientX:x,clientY:y}));});try{el.click();}catch(e){}}

function typeText(el,text,cb){el.focus();el.value='';let i=0;function next(){if(i<text.length){el.value+=text[i];['input','change','keyup'].forEach(t=>el.dispatchEvent(new Event(t,{bubbles:true})));i++;setTimeout(next,25+Math.random()*45);}else if(cb)cb();}next();}

function getAnswer(){try{
  if(typeof window.activity_type!=='undefined'&&window.activity_type==='paragraph_parallel'){
    if(window.response_type==='find_it')return(window.response_language==='l2')?window.finditchunks[window.findit_q][1]:window.finditchunks[window.findit_q][0];
    if(typeof window.get_para_sentences==='function')return window.get_para_sentences(window.para_sentence,window.response_language,false);
  }
  if(typeof window.one_word_answer!=='undefined'&&window.one_word_answer)return window.one_word_answer;
  const ran=typeof window.sentence_ran!=='undefined'?window.sentence_ran:-1;
  const lang=window.response_language||(document.querySelector('.match-sentence')?'l1':'l2');
  const isChunk=typeof window.response_type!=='undefined'&&(window.response_type==='chunk_match'||window.response_type==='chunk_flashcards');
  if(ran!==-1){
    if(lang==='l1'){
      if(isChunk&&window.uniquel1vocabchunks&&window.uniquel1vocabchunks[ran])return window.uniquel1vocabchunks[ran];
      if(isChunk&&window.uniquel1chunks&&window.uniquel1chunks[ran])return window.uniquel1chunks[ran];
      if(window.l1sentences&&window.l1sentences[ran])return window.l1sentences[ran];
      if(window.uniquel1chunks&&window.uniquel1chunks[ran])return window.uniquel1chunks[ran];
    }else{
      if(isChunk&&window.uniquel2vocabchunks&&window.uniquel2vocabchunks[ran])return window.uniquel2vocabchunks[ran];
      if(isChunk&&window.uniquel2chunks&&window.uniquel2chunks[ran])return window.uniquel2chunks[ran];
      if(window.l2sentences&&window.l2sentences[ran])return window.l2sentences[ran];
      if(window.uniquel2chunks&&window.uniquel2chunks[ran])return window.uniquel2chunks[ran];
    }
  }
  const promptEl=document.getElementById('activity-prompt-text')||document.querySelector('.sentence-prompt,.activity-prompt');
  const pText=clean(window.sentence_prompt||(promptEl&&promptEl.innerText)||'');
  if(pText){
    const pairs=[[window.l2sentences,window.l1sentences],[window.l1sentences,window.l2sentences],[window.uniquel2chunks,window.uniquel1chunks],[window.uniquel1chunks,window.uniquel2chunks],[window.uniquel2vocabchunks,window.uniquel1vocabchunks],[window.uniquel1vocabchunks,window.uniquel2vocabchunks]];
    for(const[src,dst]of pairs){
      if(!src||!dst)continue;
      const i=src.findIndex(c=>clean(c)===pText||pText.includes(clean(c))||clean(c).includes(pText));
      if(i!==-1&&dst[i])return dst[i];
    }
  }
}catch(e){}return '';}

function getTiles(){
  const specific=Array.from(document.querySelectorAll('#possible-matches button,.match-sentence,.activity-tile,button.sentence-tile,.tile-btn,.sentence-option,.answer-choice,.choice-btn')).filter(b=>vis(b)&&!b.classList.contains('disabled')&&!b.classList.contains('action_disabled')&&!b.closest('#'+ID));
  if(specific.length)return specific;
  return Array.from(document.querySelectorAll('button')).filter(b=>{
    if(!vis(b)||b.disabled||b.closest('#'+ID))return false;
    const t=(b.innerText||b.textContent||'').trim();
    return t.split(' ').length>=3&&t.length>10&&t.length<300;
  });
}

function hasActiveQuestion(){
  const inp=document.getElementById('answer-input')||document.getElementById('one-word-input');
  if(inp&&vis(inp))return true;
  return getTiles().length>0;
}

function findTile(answer){
  const tiles=getTiles();if(!tiles.length)return null;
  const ca=clean(answer);if(!ca)return tiles[0];
  for(const t of tiles){if(clean(t.innerText||t.textContent)===ca)return t;}
  const aWords=new Set(ca.split(' ').filter(w=>w.length>2));
  let best=null,bestScore=0;
  for(const t of tiles){
    const ct=clean(t.innerText||t.textContent);
    const tWords=ct.split(' ').filter(w=>w.length>2);
    const hits=tWords.filter(w=>aWords.has(w)).length;
    const score=hits/(Math.max(aWords.size,tWords.length)||1);
    if(score>bestScore){bestScore=score;best=t;}
  }
  return bestScore>0.35?best:tiles[0];
}

/* same advance-button logic as main */
function findAdvanceButton(){
  const explicit=['#next-q-button','#findit-next-button','#modal-confirm-yes-button','#circuit-modal-proceed','.sr-start-notice button','.begin-or-resume','.btn-next','#next-btn','.next-btn','#next-button','.next-button','#next_button','.next_button','button.next','a.next','#continue-button','.continue-button','#circuit-continue','#next-question'];
  for(const s of explicit){try{const el=document.querySelector(s);if(el&&vis(el)&&!el.disabled&&!el.closest('#'+ID))return el;}catch(e){}}
  const blacklist=['back','return','exit','quit','cancel','close','setting','sound','music','logout','cookie','class','fullscreen'];
  const candidates=Array.from(document.querySelectorAll('button,a,input[type="button"],input[type="submit"],[role="button"]')).filter(el=>vis(el)&&!el.disabled&&!el.closest('#'+ID));
  for(const el of candidates){
    const txt=(el.innerText||el.value||el.textContent||'').trim().toLowerCase();
    if(!txt||blacklist.some(b=>txt.includes(b)))continue;
    if(txt==='next'||txt==='next question'||txt==='continue'||txt==='resume'||txt==='proceed'||txt==='yes'||txt==='ok'||txt.startsWith('next ')||txt==='continue circuit'||txt==='next set')return el;
  }
  return null;
}

/* ── UI ── */
const panel=document.createElement('div');panel.id=ID;
panel.style.cssText='position:fixed;top:100px;right:18px;width:260px;background:#111;color:#fff;border:2px solid #ff4d4d;border-radius:9px;padding:0;z-index:2147483647;font-family:monospace;font-size:12px;box-shadow:0 8px 32px rgba(0,0,0,0.95);user-select:none;';
panel.innerHTML=`<div id="${ID}-head" style="background:#1e1e1e;padding:9px 12px;display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid #ff4d4d;border-radius:7px 7px 0 0;cursor:move;"><span style="color:#ff4d4d;font-weight:bold;font-size:13px;">:: WRAITH SOLVER ::</span><span id="${ID}-x" style="cursor:pointer;color:#666;font-size:15px;">✕</span></div><div style="padding:12px;"><div style="display:flex;gap:6px;margin-bottom:8px;"><div style="flex:1;"><div style="color:#777;font-size:10px;margin-bottom:2px;">MIN (s)</div><input id="${ID}-min" type="number" value="3.5" step="0.5" min="1" style="width:100%;background:#222;border:1px solid #444;color:#fff;padding:4px 5px;border-radius:4px;font-family:monospace;box-sizing:border-box;"></div><div style="flex:1;"><div style="color:#777;font-size:10px;margin-bottom:2px;">MAX (s)</div><input id="${ID}-max" type="number" value="7" step="0.5" min="1" style="width:100%;background:#222;border:1px solid #444;color:#fff;padding:4px 5px;border-radius:4px;font-family:monospace;box-sizing:border-box;"></div><div style="flex:1;"><div style="color:#777;font-size:10px;margin-bottom:2px;">WRONGS</div><input id="${ID}-wrongs" type="number" value="1" min="0" max="10" style="width:100%;background:#222;border:1px solid #444;color:#fff;padding:4px 5px;border-radius:4px;font-family:monospace;box-sizing:border-box;"></div></div><div id="${ID}-peek" style="background:#0a0a0a;border:1px solid #2a2a2a;border-radius:5px;padding:7px;color:#00ff88;font-size:12px;min-height:32px;margin-bottom:8px;line-height:1.4;word-break:break-word;">answer: —</div><button id="${ID}-btn" style="width:100%;background:#ff4d4d;color:#fff;border:none;padding:9px;border-radius:5px;cursor:pointer;font-weight:bold;font-family:monospace;letter-spacing:1px;font-size:13px;">START</button><div id="${ID}-status" style="margin-top:7px;font-size:10px;color:#555;text-align:center;">idle</div></div>`;
document.body.appendChild(panel);

let drag=false,sx,sy,ox,oy;
panel.querySelector('#'+ID+'-head').onmousedown=e=>{if(e.target.id===ID+'-x')return;drag=true;sx=e.clientX;sy=e.clientY;ox=panel.offsetLeft;oy=panel.offsetTop;};
document.addEventListener('mousemove',e=>{if(!drag)return;panel.style.left=(ox+e.clientX-sx)+'px';panel.style.top=(oy+e.clientY-sy)+'px';});
document.addEventListener('mouseup',()=>drag=false);

const peekBox=panel.querySelector('#'+ID+'-peek');
const statusEl=panel.querySelector('#'+ID+'-status');
const startBtn=panel.querySelector('#'+ID+'-btn');
panel.querySelector('#'+ID+'-x').onclick=()=>{stop();panel.remove();};

/* ── state — mirrors main's pattern ── */
let isRunning=false,isAnswering=false,loopInterval=null,countdownTimer=null,countdownSecLeft=0,scheduledNextTime=null,qCount=0,wrongsDone=0;

function setStatus(s){statusEl.textContent=s;}
function refreshPeek(){const a=getAnswer();peekBox.textContent=a?'answer: '+a:'answer: not found yet';peekBox.style.color=a?'#00ff88':'#ff8c00';}

function stop(){isRunning=false;isAnswering=false;scheduledNextTime=null;if(countdownTimer){clearInterval(countdownTimer);countdownTimer=null;}if(loopInterval){clearInterval(loopInterval);loopInterval=null;}startBtn.textContent='START';startBtn.style.background='#ff4d4d';setStatus('idle');}

function executeAnswer(){
  isAnswering=true;
  const targetWrongs=parseInt(panel.querySelector('#'+ID+'-wrongs').value)||0;
  const makeWrong=qCount>0&&wrongsDone<targetWrongs&&Math.random()<0.45;
  const ans=getAnswer();

  /* text input */
  const inp=document.getElementById('answer-input')||document.getElementById('one-word-input');
  if(inp&&vis(inp)&&ans){
    const checkFn=window.section1_input_activity_INPUT_CHECK;
    if(makeWrong){
      wrongsDone++;setStatus('wrong answer...');
      typeText(inp,ans.slice(0,-1)+'x',()=>{
        if(typeof checkFn==='function')checkFn();
        setTimeout(()=>{inp.value='';typeText(inp,ans,()=>{if(typeof checkFn==='function')checkFn();isAnswering=false;});},700+Math.random()*300);});
    }else{
      setStatus('typing...');
      typeText(inp,ans,()=>{if(typeof checkFn==='function')checkFn();isAnswering=false;});}
    return;}

  /* tile */
  const tiles=getTiles();
  if(tiles.length>0){
    const target=ans?findTile(ans):tiles[0];
    if(makeWrong&&tiles.length>1){
      const wrong=tiles.find(t=>t!==target)||tiles[tiles.length-1];
      wrongsDone++;setStatus('wrong tile...');
      humanClick(wrong);
      setTimeout(()=>{setStatus('fixing...');if(target)humanClick(target);waitForOK(()=>{isAnswering=false;});},700+Math.random()*300);
    }else{
      setStatus('clicking: '+clean((target.innerText||'').slice(0,22))+'...');
      humanClick(target);
      waitForOK(()=>{isAnswering=false;});}
    return;}

  isAnswering=false;
}

/* after clicking a tile, poll specifically for an OK button before releasing control */
function waitForOK(cb){
  let attempts=0;
  const poll=setInterval(()=>{
    if(!isRunning){clearInterval(poll);cb();return;}
    const ok=Array.from(document.querySelectorAll('button,input[type="button"],input[type="submit"],[role="button"]')).find(b=>{
      if(!vis(b)||b.closest('#'+ID))return false;
      const t=(b.innerText||b.value||b.textContent||'').trim().toLowerCase();
      return t==='ok'||t==='okay';
    });
    if(ok){
      clearInterval(poll);
      setStatus('clicking OK...');
      setTimeout(()=>{humanClick(ok);cb();},400+Math.random()*300);
      return;
    }
    attempts++;
    if(attempts>20){clearInterval(poll);cb();}/* give up after 2s, let main loop handle it */
  },100);
}

function startCountdown(){
  if(countdownTimer)return;
  const minVal=parseFloat(panel.querySelector('#'+ID+'-min').value)||3.5;
  const maxVal=parseFloat(panel.querySelector('#'+ID+'-max').value)||7;
  const delaySec=Math.random()*(Math.max(minVal,maxVal)-Math.min(minVal,maxVal))+Math.min(minVal,maxVal);
  countdownSecLeft=delaySec;
  const targetWrongs=parseInt(panel.querySelector('#'+ID+'-wrongs').value)||0;
  countdownTimer=setInterval(()=>{
    if(!isRunning){clearInterval(countdownTimer);countdownTimer=null;return;}
    if(findAdvanceButton()){clearInterval(countdownTimer);countdownTimer=null;return;}
    countdownSecLeft-=0.1;
    if(countdownSecLeft<=0){
      clearInterval(countdownTimer);countdownTimer=null;
      executeAnswer();
    }else{
      setStatus('clicking in '+countdownSecLeft.toFixed(1)+'s  wrongs: '+wrongsDone+'/'+targetWrongs);}
  },100);}

function tick(){
  if(!isRunning||isAnswering)return;
  refreshPeek();
  const adv=findAdvanceButton();
  if(adv){
    if(countdownTimer){clearInterval(countdownTimer);countdownTimer=null;}
    if(!scheduledNextTime){scheduledNextTime=Date.now()+1200;setStatus('next found...');}
    else if(Date.now()>=scheduledNextTime){scheduledNextTime=null;humanClick(adv);qCount++;setStatus('next → q'+qCount);}
    return;
  }
  scheduledNextTime=null;
  if(hasActiveQuestion()){if(!countdownTimer)startCountdown();}
  else{if(countdownTimer){clearInterval(countdownTimer);countdownTimer=null;}setStatus('waiting...');}
}

startBtn.onclick=()=>{
  if(isRunning){stop();}
  else{isRunning=true;isAnswering=false;qCount=0;wrongsDone=0;scheduledNextTime=null;
    startBtn.textContent='STOP';startBtn.style.background='#444';setStatus('running');
    if(loopInterval)clearInterval(loopInterval);
    loopInterval=setInterval(tick,300);tick();}};

setInterval(refreshPeek,1200);
})();
