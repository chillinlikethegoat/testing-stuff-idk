function findTile(answer){
  const tiles=getTiles();if(!tiles.length)return null;
  const ca=clean(answer);if(!ca)return tiles[0];
  for(const t of tiles){if(clean(t.innerText||t.textContent)===ca)return t;}
  const built=clean(getBuiltAnswer());
  if(built&&ca.length>built.length){const idx=ca.indexOf(built);if(idx!==-1){const remaining=ca.slice(idx+built.length).trim();for(const t of tiles){const ct=clean(t.innerText||t.textContent);if(ct.length>2&&remaining.startsWith(ct))return t;}}}
  const withPos=tiles.map(t=>{const ct=clean(t.innerText||t.textContent);return{el:t,ct,pos:ct.length>2?ca.indexOf(ct):-1};}).filter(x=>x.pos!==-1).sort((a,b)=>a.pos-b.pos);
  if(withPos.length)return withPos[0].el;
  const aWords=new Set(ca.split(' ').filter(w=>w.length>2));let best=null,bestScore=0;
  for(const t of tiles){const ct=clean(t.innerText||t.textContent);const tWords=ct.split(' ').filter(w=>w.length>2);const hits=tWords.filter(w=>aWords.has(w)).length;const score=hits/(Math.max(aWords.size,tWords.length)||1);if(score>bestScore){bestScore=score;best=t;}}
  return bestScore>0.35?best:tiles[0];
}
/* click_all tile finder — tracks each chunk we've clicked so matching uses REMAINING not full answer */
let clickedChunks=[],currentChunkSentRan=-1;
function resetClickedChunks(){clickedChunks=[];currentChunkSentRan=typeof window.sentence_ran!=='undefined'?window.sentence_ran:-1;}
function findTileForClickAll(answer){
  const tiles=getTiles();if(!tiles.length)return null;
  const ran=typeof window.sentence_ran!=='undefined'?window.sentence_ran:-1;
  if(ran!==currentChunkSentRan){clickedChunks=[];currentChunkSentRan=ran;}
  const ca=clean(answer);
  // build "already clicked" string from tracked chunks
  let built='';
  for(const c of clickedChunks){
    const next=(built?built+' ':'')+c;
    if(ca.startsWith(next))built=next;else break;
  }
  const remaining=built?ca.slice(built.length).trim():ca;
  if(!remaining)return null;
  // 1. tile text exactly starts the remaining portion
  for(const t of tiles){const ct=clean(t.innerText||t.textContent);if(ct.length>0&&remaining.startsWith(ct))return t;}
  // 2. tile text appears earliest in remaining
  const withPos=tiles.map(t=>{const ct=clean(t.innerText||t.textContent);return{el:t,ct,pos:ct.length>1?remaining.indexOf(ct):-1};}).filter(x=>x.pos!==-1).sort((a,b)=>a.pos-b.pos);
  if(withPos.length)return withPos[0].el;
  // 3. word overlap with remaining (never fall back to tiles[0] — better to skip than click wrong)
  const remWords=new Set(remaining.split(' ').filter(w=>w.length>2));let best=null,bestScore=0;
  for(const t of tiles){const ct=clean(t.innerText||t.textContent);const tWords=ct.split(' ').filter(w=>w.length>2);const hits=tWords.filter(w=>remWords.has(w)).length;const score=hits/(Math.max(remWords.size,tWords.length)||1);if(score>bestScore){bestScore=score;best=t;}}
  return bestScore>0.25?best:null;
}
