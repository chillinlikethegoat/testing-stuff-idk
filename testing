document.body.appendChild(panel);

let drag=false,sx,sy,ox,oy;
panel.querySelector('#'+ID+'-head').onmousedown=e=>{if(e.target.id===ID+'-x')return;drag=true;sx=e.clientX;sy=e.clientY;ox=panel.offsetLeft;oy=panel.offsetTop;};
document.addEventListener('mousemove',e=>{if(!drag)return;panel.style.left=(ox+e.clientX-sx)+'px';panel.style.top=(oy+e.clientY-sy)+'px';});
document.addEventListener('mouseup',()=>drag=false);

const peekBox=panel.querySelector('#'+ID+'-peek');
const statusEl=panel.querySelector('#'+ID+'-status');
const startBtn=panel.querySelector('#'+ID+'-btn');
const qCountEl=panel.querySelector('#'+ID+'-qcount');
const wCountEl=panel.querySelector('#'+ID+'-wcount');
const setNumEl=panel.querySelector('#'+ID+'-setnum');
panel.querySelector('#'+ID+'-x').onclick=()=>{stop();panel.remove();};

/* ── state ── */
let isRunning=false,isAnswering=false,loopInterval=null,countdownTimer=null,countdownSecLeft=0,scheduledNextTime=null;
let qCount=0;
/* per-chunk wrong tracking */
let chunkWrongsDone=0,chunkWrongsTarget=0,lastSentenceRan=-1,lastSetNum=-1;

function randBetween(a,b){return Math.floor(Math.random()*(b-a+1))+a;}
function newChunkTarget(){
  const wMin=parseInt(panel.querySelector('#'+ID+'-wmin').value)||2;
  const wMax=parseInt(panel.querySelector('#'+ID+'-wmax').value)||3;
  return randBetween(wMin,wMax);
}

function getCurrentSet(){
  const m=(document.body.innerText||'').match(/Set\s+(\d+)\s+of\s+(\d+)/i);
  return m?parseInt(m[1]):-1;
}

function detectChunkReset(){
  const ran=typeof window.sentence_ran!=='undefined'?window.sentence_ran:-1;
  const setNum=getCurrentSet();
  let newChunk=false;
  if(setNum>0&&setNum!==lastSetNum){newChunk=true;lastSetNum=setNum;}
  else if(ran>=0&&ran<lastSentenceRan-1){newChunk=true;}/* sentence_ran jumped back */
  if(ran>=0)lastSentenceRan=ran;
  if(newChunk){chunkWrongsDone=0;chunkWrongsTarget=newChunkTarget();}
}

function updateStats(){
  qCountEl.textContent=qCount;
  wCountEl.textContent=chunkWrongsDone+'/'+chunkWrongsTarget;
  const s=getCurrentSet();setNumEl.textContent=s>0?s:'—';
}

function setStatus(s){statusEl.textContent=s;}
function refreshPeek(){const a=getAnswer();peekBox.textContent=a||'—';peekBox.style.color=a?'#00e676':'#ff8c00';}

function stop(){isRunning=false;isAnswering=false;scheduledNextTime=null;if(countdownTimer){clearInterval(countdownTimer);countdownTimer=null;}if(loopInterval){clearInterval(loopInterval);loopInterval=null;}startBtn.textContent='START';startBtn.style.background='#ff4d4d';setStatus('idle');}

function waitForOK(cb){
  let attempts=0;
  const poll=setInterval(()=>{
    if(!isRunning){clearInterval(poll);cb();return;}
    const ok=Array.from(document.querySelectorAll('button,input[type="button"],input[type="submit"],[role="button"]')).find(b=>{
      if(!vis(b)||b.closest('#'+ID))return false;
      const t=(b.innerText||b.value||b.textContent||'').trim().toLowerCase();
      return t==='ok'||t==='okay';
    });
    if(ok){clearInterval(poll);setStatus('clicking OK...');setTimeout(()=>{humanClick(ok);cb();},350+Math.random()*250);return;}
    if(++attempts>25){clearInterval(poll);cb();}
  },100);
}

function executeAnswer(){
  isAnswering=true;
  detectChunkReset();
  const makeWrong=chunkWrongsDone<chunkWrongsTarget&&Math.random()<0.5;
  const ans=getAnswer();

  const inp=document.getElementById('answer-input')||document.getElementById('one-word-input');
  if(inp&&vis(inp)&&ans){
    const checkFn=window.section1_input_activity_INPUT_CHECK;
    if(makeWrong){
      chunkWrongsDone++;setStatus('wrong on purpose...');updateStats();
      typeText(inp,ans.slice(0,-1)+'x',()=>{if(typeof checkFn==='function')checkFn();setTimeout(()=>{inp.value='';typeText(inp,ans,()=>{if(typeof checkFn==='function')checkFn();isAnswering=false;});},650+Math.random()*350);});
    }else{
      setStatus('typing...');
      typeText(inp,ans,()=>{if(typeof checkFn==='function')checkFn();isAnswering=false;});}
    return;}

  const tiles=getTiles();
  if(tiles.length>0){
    const target=ans?findTile(ans):tiles[0];
    if(makeWrong&&tiles.length>1){
      const wrong=tiles.find(t=>t!==target)||tiles[tiles.length-1];
      chunkWrongsDone++;setStatus('wrong tile...');updateStats();
      humanClick(wrong);
      setTimeout(()=>{setStatus('fixing...');if(target)humanClick(target);waitForOK(()=>{isAnswering=false;});},650+Math.random()*350);
    }else{
      setStatus('→ '+clean((target.innerText||'').slice(0,24))+'...');
      humanClick(target);waitForOK(()=>{isAnswering=false;});}
    return;}

  isAnswering=false;
}

function startCountdown(){
  if(countdownTimer)return;
  const minVal=parseFloat(panel.querySelector('#'+ID+'-min').value)||3.5;
  const maxVal=parseFloat(panel.querySelector('#'+ID+'-max').value)||8;
  const delaySec=Math.random()*(Math.max(minVal,maxVal)-Math.min(minVal,maxVal))+Math.min(minVal,maxVal);
  countdownSecLeft=delaySec;
  countdownTimer=setInterval(()=>{
    if(!isRunning){clearInterval(countdownTimer);countdownTimer=null;return;}
    if(findAdvanceButton()){clearInterval(countdownTimer);countdownTimer=null;return;}
    countdownSecLeft-=0.1;
    if(countdownSecLeft<=0){clearInterval(countdownTimer);countdownTimer=null;qCount++;updateStats();executeAnswer();}
    else{setStatus('answering in '+countdownSecLeft.toFixed(1)+'s');}
  },100);
}

function tick(){
  if(!isRunning||isAnswering)return;
  refreshPeek();
  const adv=findAdvanceButton();
  if(adv){
    if(countdownTimer){clearInterval(countdownTimer);countdownTimer=null;}
    if(!scheduledNextTime){scheduledNextTime=Date.now()+1100+Math.random()*400;setStatus('moving to next...');}
    else if(Date.now()>=scheduledNextTime){scheduledNextTime=null;humanClick(adv);setStatus('next →');}
    return;
  }
  scheduledNextTime=null;
  if(hasActiveQuestion()){if(!countdownTimer)startCountdown();}
  else{if(countdownTimer){clearInterval(countdownTimer);countdownTimer=null;}setStatus('waiting...');}
}

startBtn.onclick=()=>{
  if(isRunning){stop();}
  else{
    isRunning=true;isAnswering=false;qCount=0;chunkWrongsDone=0;chunkWrongsTarget=newChunkTarget();lastSentenceRan=-1;lastSetNum=-1;scheduledNextTime=null;
    startBtn.textContent='STOP';startBtn.style.background='#333';setStatus('running');
    updateStats();
    if(loopInterval)clearInterval(loopInterval);
    loopInterval=setInterval(tick,300);tick();}};

setInterval(()=>{refreshPeek();updateStats();},1200);
})();
